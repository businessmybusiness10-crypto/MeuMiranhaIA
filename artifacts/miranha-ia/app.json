{
  "expo": {
    "name": "Miranha IA ❤️",
    "slug": "miranha-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miranha-ia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0714"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miranhaia.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.miranhaia.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#e85d8f",
          "defaultChannel": "spider-calls"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
